# Public Supabase Auth and database access.
# For local Supabase, run `pnpm supabase:status` and copy API_URL here.
NEXT_PUBLIC_SUPABASE_URL=

# Copy the publishable key from Supabase project settings. Local Supabase may
# report this value as ANON_KEY instead; use the legacy variable below for it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy key name supported for local projects and older Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
