# Server-side Supabase access for Next.js API routes.
# For local Supabase, run `pnpm supabase:status` and copy API_URL here.
SUPABASE_URL=

# Keep this secret. It is only read by server-side route handlers.
# For local Supabase, run `pnpm supabase:status` and copy SERVICE_ROLE_KEY here.
SUPABASE_SERVICE_ROLE_KEY=

# Optional for future browser-side auth or realtime work.
# The current Kanban board does not use these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
